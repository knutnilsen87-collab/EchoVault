# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://echovault:echovault@localhost:54329/echovault

# 32+ random chars. Signs session cookies and local signed download URLs.
AUTH_SECRET=change-me-to-a-long-random-string-0123456789

# stub = no real Stripe/R2 calls (local dev, CI). live = real providers.
ECHOVAULT_PROVIDER_MODE=stub
# Fake Stripe checkout page. Defaults to on in dev, off when NODE_ENV=production (set true for demos/CI on a prod build).
# ECHOVAULT_ALLOW_STUB_CHECKOUT=true

# ─── Stripe (required in live mode; stub mode signs fake events with this) ─
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_local_dev_secret

# ─── Object storage ─────────────────────────────────────────────────────
# local = files on disk under STORAGE_LOCAL_DIR, served via HMAC-signed URLs.
# s3    = S3/R2 with presigned URLs (live).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET_PRIVATE=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── EchoScore ──────────────────────────────────────────────────────────
ECHOSCORE_SERVICE_URL=http://localhost:8001
# Shared secret between worker and EchoScore service.
ECHOSCORE_SERVICE_TOKEN=change-me-service-token

# Optional: ffmpeg used for MP3 previews. Defaults to `ffmpeg` on PATH (start.bat installs it via winget).
# FFMPEG_PATH=
