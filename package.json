{
  "name": "echovault",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @echovault/web dev",
    "build": "pnpm --filter @echovault/web build",
    "worker": "pnpm --filter @echovault/web worker",
    "db:migrate": "pnpm --filter @echovault/web migrate",
    "db:seed": "pnpm --filter @echovault/web seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
